# Shared API keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
FACT_CHECK_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Firebase / Firestore
FIREBASE_PROJECT_ID=
FIRESTORE_ANALYSES_COLLECTION=contentAnalyses
FIRESTORE_TRANSPORT=rest
NOTICIAS_GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/noticias/base-mediahackii-dde4ddaa87de.json
VIDEO_AUDIO_GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/video-audio/google-credentials.json

# Noticias backend
NOTICIAS_LLM_PROVIDER=auto
NOTICIAS_LLM_FALLBACK_ON_ERROR=true
GDELT_ENABLED=true
GDELT_TIMESPAN=3months
GDELT_MAX_RECORDS=10
GDELT_QUERY_LIMIT=5
GDELT_TIMEOUT_SECONDS=5
NEWS_RSS_ENABLED=true
NEWS_RSS_QUERY_LIMIT=3
NEWS_RSS_TIMEOUT_SECONDS=6
DUCKDUCKGO_FALLBACK_QUERY_LIMIT=4
DUCKDUCKGO_TIMEOUT_SECONDS=4
RELATED_SOURCE_SEARCH_LIMIT=5
REQUEST_TIMEOUT_SECONDS=12
MAX_HTML_BYTES=2000000
MAX_ARTICLE_CHARS=24000
RELATED_NEWS_LIMIT=6

# Video/Audio backend
MAX_FILE_SIZE=52428800
ALLOWED_AUDIO_FORMATS=mp3,wav,ogg,m4a,flac
ALLOWED_VIDEO_FORMATS=mp4,avi,mov,mkv,webm
AUDIO_CONFIDENCE_THRESHOLD=0.7
VIDEO_CONFIDENCE_THRESHOLD=0.7
WHISPER_MODEL=base
WHISPER_LANGUAGE=es
ENABLE_FACT_CHECKING=true
ENABLE_FAKE_NEWS_DETECTION=true
FAKE_NEWS_THRESHOLD=0.7
