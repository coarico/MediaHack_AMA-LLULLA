  "rules": {
    "primary_source_priority": "When a primary source exists for the information type, always prioritize it over secondary sources",
    "competence_principle": "Determine which source has direct competence over the information type, not just authority",
    "temporal_context": "Consider whether the information is about past events (historical) or future events (requires official announcement)",
    "evidence_corroboration": "For contradictions, require evidence from at least two independent primary sources before accepting as fact",
    "editorial_use": "Use editorial alignment only to identify perspectives and possible biases, never to determine truthfulness",
    "social_media_rule": "Social media content is only a starting point. Must find corroborating evidence from primary or secondary sources"
  }
