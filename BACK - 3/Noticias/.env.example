CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://TU-FRONT-5173.use2.devtunnels.ms
# Permite frontends publicados por VS Code Ports/GitHub Codespaces.
CORS_ORIGIN_REGEX=https://.*(app\.github\.dev|githubpreview\.dev|vscode-cdn\.net|devtunnels\.ms)

# LLM. Si no se configura ninguna API key, el backend usa analisis heuristico local.
# auto usa Groq si GROQ_API_KEY existe; si no, usa OpenAI si OPENAI_API_KEY existe.
LLM_PROVIDER=auto
LLM_FALLBACK_ON_ERROR=true

# OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini / Firebase AI (Kuybot)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fact Check Tools API (Google)
FACT_CHECK_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=

# Groq. No pegues llaves en Git; usa una key nueva solo en .env local.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Firebase Admin / Firestore. Si no se configura, el backend usa memoria local.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_ANALYSES_COLLECTION=contentAnalyses
FIRESTORE_TRANSPORT=rest

# GDELT gratuito para noticias relacionadas. No requiere API key.
GDELT_ENABLED=true
GDELT_TIMESPAN=3months
GDELT_MAX_RECORDS=10
GDELT_QUERY_LIMIT=5
GDELT_TIMEOUT_SECONDS=5
NEWS_RSS_ENABLED=true
NEWS_RSS_QUERY_LIMIT=3
NEWS_RSS_TIMEOUT_SECONDS=6
DUCKDUCKGO_FALLBACK_QUERY_LIMIT=4
DUCKDUCKGO_TIMEOUT_SECONDS=4

# Google Custom Search. Si no se configura, Kuybot omite busqueda web externa.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

REQUEST_TIMEOUT_SECONDS=12
MAX_HTML_BYTES=2000000
MAX_ARTICLE_CHARS=24000
RELATED_NEWS_LIMIT=6
RELATED_SOURCE_SEARCH_LIMIT=5
