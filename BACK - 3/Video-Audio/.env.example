# Application
APP_NAME=AMA-LLU-IA Video/Audio Analyzer
APP_VERSION=1.0.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8001

# File Upload
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_AUDIO_FORMATS=mp3,wav,ogg,m4a,flac
ALLOWED_VIDEO_FORMATS=mp4,avi,mov,mkv,webm

# Temporary Storage
TEMP_DIR=./temp
UPLOAD_DIR=./uploads

# Analysis Thresholds
AUDIO_CONFIDENCE_THRESHOLD=0.7
VIDEO_CONFIDENCE_THRESHOLD=0.7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://coarico.github.io
