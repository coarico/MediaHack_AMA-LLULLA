# Application
APP_NAME=AMA-LLU-IA Video/Audio Analyzer
APP_VERSION=1.0.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8001

# File Upload
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_AUDIO_FORMATS=mp3,wav,ogg,m4a,flac
ALLOWED_VIDEO_FORMATS=mp4,avi,mov,mkv,webm

# Temporary Storage
TEMP_DIR=./temp
UPLOAD_DIR=./uploads

# Analysis Thresholds
AUDIO_CONFIDENCE_THRESHOLD=0.7
VIDEO_CONFIDENCE_THRESHOLD=0.7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://coarico.github.io

# Google APIs
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
GOOGLE_FACT_CHECK_API_KEY=your_api_key_here

# Speech-to-Text
WHISPER_MODEL=base  # tiny, base, small, medium, large
WHISPER_LANGUAGE=es

# Speech-to-Text (Deepgram) - usado por TranscriptionService
DEEPGRAM_API_KEY=your_api_key_here
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=es

# Content Analysis
ENABLE_FACT_CHECKING=True
ENABLE_FAKE_NEWS_DETECTION=True
FAKE_NEWS_THRESHOLD=0.7
