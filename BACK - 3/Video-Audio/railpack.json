{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.11"
  },
  "buildAptPackages": ["...", "build-essential", "gcc", "g++"],
  "steps": {
    "install": {
      "commands": [
        "pip install setuptools==80.9.0 wheel",
        "pip install --no-build-isolation openai-whisper==20231117",
        "test -f requirements.txt && pip install -r requirements.txt || pip install -r railway-video-audio-requirements.txt"
      ]
    }
  },
  "deploy": {
    "aptPackages": ["...", "ffmpeg", "libgl1", "libglib2.0-0", "libsndfile1"],
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT"
  }
}
